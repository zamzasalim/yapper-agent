# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Solana ───────────────────────────────────────────────────────────────────
# devnet (default for local testing) or mainnet (production)
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
# Mainnet RPC (switch when going live):
# NEXT_PUBLIC_SOLANA_NETWORK=mainnet
# NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
# Or use a paid RPC (Helius, QuickNode, Alchemy):
# NEXT_PUBLIC_SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=xxxxxxxx

# ─── Escrow Contract ──────────────────────────────────────────────────────────
# Deployed Anchor program ID (run: anchor build && anchor deploy --provider.cluster devnet)
# Vault PDA and State PDA are auto-derived from this program ID — no manual update needed
NEXT_PUBLIC_ESCROW_PROGRAM_ID=PLACEHOLDER_PROGRAM_ID
# USDC mint — devnet:   4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
#            mainnet:  EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ─── NEXT PUBLIC ──────────────────────────────────────────────────────────────
